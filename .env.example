# TMDB API
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
EXPO_PUBLIC_TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here
EXPO_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3

# Convex
CONVEX_DEPLOYMENT=dev:your-deployment-name
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# AniList
EXPO_PUBLIC_ANILIST_URL=https://graphql.anilist.co

# TVMaze
EXPO_PUBLIC_TVMAZE_BASE_URL=https://api.tvmaze.com

# Jikan
EXPO_PUBLIC_JIKAN_BASE_URL=https://api.jikan.moe/v4

# Monetization preview
# Keep demo mode enabled locally so the Subscribe page can remove ads without live payment keys.
EXPO_PUBLIC_SHOW_ADS=true
EXPO_PUBLIC_MONETIZATION_DEMO_MODE=true
EXPO_PUBLIC_BILLING_PROVIDER=demo
EXPO_PUBLIC_AD_PROVIDER=admob
EXPO_PUBLIC_PREMIUM_PLAN_ID=showtracker_plus_monthly
# RevenueCat public SDK keys. Use platform-specific keys in production; the generic
# key remains a local fallback for quick prototype testing.
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=
# Match this to the RevenueCat entitlement identifier. The app also checks ad_free and plus aliases.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=ad_free
# Optional comma-separated fallback entitlement identifiers while testing dashboard naming.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ALIASES=
# Optional offering id. Leave blank to use the RevenueCat current offering.
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=
# Web defaults to the local test checkout unless RevenueCat Web Billing/paywalls are configured.
EXPO_PUBLIC_REVENUECAT_WEB_PAYWALL_ENABLED=false
# Set this to a RevenueCat Web Purchase Link, Clerk Billing checkout URL, or Stripe Checkout link.
EXPO_PUBLIC_SUBSCRIPTION_CHECKOUT_URL=

# Native AdMob. Test ads use Google's sample ad unit IDs until production AdMob units exist.
EXPO_PUBLIC_ADMOB_TEST_ADS=true
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=

# Web Google Publisher Tag. Test ads use Google's sample Ad Manager ad unit.
EXPO_PUBLIC_GPT_TEST_ADS=true
EXPO_PUBLIC_GPT_AD_UNIT_PATH=
EXPO_PUBLIC_GPT_HOME_TOP_AD_UNIT_PATH=
EXPO_PUBLIC_GPT_HOME_INLINE_AD_UNIT_PATH=
EXPO_PUBLIC_GPT_SCHEDULE_TOP_AD_UNIT_PATH=
EXPO_PUBLIC_GPT_PROFILE_AD_UNIT_PATH=
EXPO_PUBLIC_GPT_BANNER_SIZES=300x250

# Clerk dashboard keys. The current app runtime still uses Convex Auth; these are for the
# prepared Clerk dashboard/billing prototype and a future auth migration.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex webhook environment. Set these with `npx convex env set`; do not expose them
# through EXPO_PUBLIC_* variables.
MONETIZATION_ENTITLEMENT_IDS=ad_free,plus
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer replace-with-random-shared-secret
CLERK_BILLING_WEBHOOK_AUTHORIZATION=Bearer replace-with-random-shared-secret
CLERK_BILLING_WEBHOOK_SIGNING_SECRET=whsec_replace_with_clerk_endpoint_secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_with_clerk_endpoint_secret
CLERK_BILLING_PLUS_PLAN_IDS=showtracker_plus_monthly,plus,ShowTracker Plus
CLERK_BILLING_ALLOW_AUTHORIZATION_FALLBACK=false
