# TMDB API
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
EXPO_PUBLIC_TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here
EXPO_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3

# Convex
CONVEX_DEPLOYMENT=dev:your-deployment-name
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Keep the previous namespace when moving an existing website between deployments.
# Leave unset for a new environment to use its own Convex URL.
# EXPO_PUBLIC_AUTH_STORAGE_NAMESPACE=https://previous-deployment.convex.cloud
# Convex dashboard/CLI only: comma-separated users table IDs allowed to approve accounts.
# Never grant owner access from an unverified email address or a client environment variable.
# SHOWTRACKER_ADMIN_USER_IDS=owner_user_id

# AniList
EXPO_PUBLIC_ANILIST_URL=https://graphql.anilist.co

# TVMaze
EXPO_PUBLIC_TVMAZE_BASE_URL=https://api.tvmaze.com

# Jikan
EXPO_PUBLIC_JIKAN_BASE_URL=https://api.jikan.moe/v4
